# Pflegeoberfläche – Passwortschutz (HTTP Basic Auth)
#
# 1) .htpasswd AUSSERHALB des Webroots anlegen, z. B. auf dem Server:
#      htpasswd -c -B /var/www/htpasswd/cafe-am-schloss.htpasswd kunde
# 2) Den absoluten Pfad unten bei AuthUserFile eintragen.
#
# Solange der Pfad nicht stimmt, liefert Apache einen Fehler – die Oberfläche ist dann
# nicht erreichbar (gewollt). admin/index.php verweigert außerdem den Zugriff, wenn keine
# Anmeldung aktiv ist (z. B. falls .htaccess-Dateien vom Server ignoriert werden).

AuthType Basic
AuthName "Pflege Cafe am Schloss"
AuthUserFile /.htpasswd
Require valid-user

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
